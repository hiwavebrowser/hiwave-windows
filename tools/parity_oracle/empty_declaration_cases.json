{
 "oracle": "148.0.7778.216",
 "source": "CH2.E28: an empty declaration (`;;`) or one without a colon is skipped and the next declaration applies. Pages are synthetic; chrome is written by declaration_list_log.mjs --write.",
 "cases": [
  {
   "name": "rule: empty declaration between two",
   "html": "<!doctype html><style>body{margin:0}</style><body><style>#a{color:rgb(255, 0, 0);;background-color:rgb(0, 0, 255)}</style><div id=a>x</div>",
   "expr": "(function(){var s=getComputedStyle(document.getElementById('a'));return [s.getPropertyValue('color'),s.getPropertyValue('background-color')].join(' | ')})()",
   "chrome": "rgb(255, 0, 0) | rgb(0, 0, 255)"
  },
  {
   "name": "rule: leading empty declarations",
   "html": "<!doctype html><style>body{margin:0}</style><body><style>#a{;;color:rgb(255, 0, 0)}</style><div id=a>x</div>",
   "expr": "(function(){var s=getComputedStyle(document.getElementById('a'));return [s.getPropertyValue('color')].join(' | ')})()",
   "chrome": "rgb(255, 0, 0)"
  },
  {
