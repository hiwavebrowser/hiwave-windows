   "html": "<!doctype html><html><head><style>body{margin:0;font:16px/20px monospace} c-shell,c-card,c-plain,c-dsd,c-dsd-bare,c-nest,c-cb-throws,c-fade,c-veil,c-after{display:block} c-plain:not(:defined){display:none} c-ghost:not(:defined){display:block;height:30px} c-hold:not(:defined){display:block;visibility:hidden} c-dsd:not(:defined){height:5px} .light{width:200px}</style></head><body><c-shell id=shell style=\"background:rgb(13,111,119)\"><div id=shell-title slot=title style=\"height:8px;background:rgb(26,182,148)\"></div><div id=shell-body style=\"height:10px;background:rgb(39,253,177)\"></div></c-shell><c-card id=card class=wide style=\"background:rgb(52,68,206)\"><p id=card-p style=\"margin:0;background:rgb(65,139,235)\"></p><div id=card-div style=\"height:6px;background:rgb(78,210,8)\"></div></c-card><c-plain id=plain style=\"background:rgb(91,25,37)\"><div id=plain-a style=\"height:7px;background:rgb(104,96,66)\"></div><c-plain-kid id=plain-kid style=\"display:block;height:4px;background:rgb(117,167,95)\"></c-plain-kid></c-plain><c-ghost id=ghost style=\"background:rgb(130,238,124)\"><div id=ghost-a style=\"height:9px;background:rgb(143,53,153)\"></div><div id=ghost-b style=\"height:3px;background:rgb(156,124,182)\"></div></c-ghost><c-hold id=hold style=\"height:12px;background:rgb(169,195,211)\"><div id=hold-a style=\"height:4px;background:rgb(182,10,240)\"></div><div id=hold-show style=\"height:4px;background:rgb(195,81,13);visibility:visible\"></div></c-hold><c-dsd id=dsd style=\"background:rgb(208,152,42)\"><template shadowrootmode=open><style>:host{padding:3px} ::slotted(*){margin:1px}</style><div id=dsd-in style=\"height:4px;background:rgb(221,223,71)\"></div><slot></slot></template><div id=dsd-a style=\"height:6px;background:rgb(234,38,100)\"></div></c-dsd><c-dsd-bare id=bare style=\"background:rgb(247,109,129)\"><template shadowrootmode=open><div id=bare-in style=\"height:5px;background:rgb(4,180,158)\"></div></template><div id=bare-a style=\"height:50px;background:rgb(17,251,187)\"></div></c-dsd-bare><c-nest id=nest style=\"background:rgb(30,66,216)\"><div id=nest-a style=\"height:7px;background:rgb(43,137,245)\"></div></c-nest><c-cb-throws id=cbt style=\"background:rgb(56,208,18)\"><div id=cbt-a style=\"height:5px;background:rgb(69,23,47)\"></div></c-cb-throws><c-fade id=fade style=\"background:rgb(82,94,76)\"><div id=fade-a style=\"height:5px;background:rgb(95,165,105)\"></div></c-fade><c-veil id=veil style=\"background:rgb(108,236,134)\"><div id=veil-a class=x style=\"height:4px;background:rgb(121,51,163)\"></div><div id=veil-show class=show style=\"height:4px;background:rgb(134,122,192)\"></div></c-veil><c-after id=after style=\"background:rgb(147,193,221)\"><div id=after-a style=\"height:6px;background:rgb(160,8,250)\"></div><header id=after-h style=\"height:5px;background:rgb(173,79,23)\"><div id=after-logo style=\"height:3px;background:rgb(186,150,52);width:30px;margin-left:9px\"></div></header></c-after><script>function def(name, init) { customElements.define(name, class extends HTMLElement { constructor() { super(); if (init) init(this); } }); }def('c-shell', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host{padding:2px} slot[name=title]::slotted(*){width:100px}</style><div id=shell-in style=\"height:3px;background:rgb(199,221,81)\"></div><slot name=title></slot><slot></slot>'; });def('c-card', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host(.wide){width:300px} :host{width:100px;border:2px solid red} ::slotted(p){height:12px}</style><div id=card-in style=\"height:2px;background:rgb(225,107,139)\"></div><slot></slot>'; });def('c-plain');def('c-dsd');def('c-nest', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host{padding:1px}</style><c-inner id=inner style=\"display:block;background:rgb(212,36,110)\"><slot></slot></c-inner>'; });def('c-inner', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host{padding:2px} ::slotted(slot){color:red}</style><slot></slot>'; });customElements.define('c-cb-throws', class extends HTMLElement { connectedCallback() { throw new Error('cb'); } });def('c-fade', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host{opacity:0}</style><div id=fade-in style=\"height:2px;background:rgb(238,178,168)\"></div><slot></slot>'; });def('c-veil', function (el) { el.attachShadow({mode:'open'}).innerHTML = '<style>:host{visibility:hidden} ::slotted(.show){visibility:visible}</style><div id=veil-in style=\"height:2px;background:rgb(251,249,197)\"></div><slot></slot>'; });</script></body></html>",
