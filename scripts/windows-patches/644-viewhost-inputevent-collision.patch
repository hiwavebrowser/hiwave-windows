Upstream issue: hiwave-macos CH2.E3 (01c33cb2) re-exports input_queue::InputEvent from the
crate root; the cfg(windows) `use rustkit_core::{.., InputEvent, ..}` then defines the name
twice (E0252) and rustkit-viewhost does not compile on Windows. The Windows side keeps its
own type under an alias. Remove after upstream renames one of the two.

--- a/crates/rustkit-viewhost/src/lib.rs
+++ b/crates/rustkit-viewhost/src/lib.rs
@@ -57,7 +57,7 @@
 
 #[cfg(windows)]
 use rustkit_core::{
-    FocusEvent, FocusEventType, InputEvent, KeyCode, KeyEvent, KeyEventType, KeyboardState,
+    FocusEvent, FocusEventType, InputEvent as CoreInputEvent, KeyCode, KeyEvent, KeyEventType, KeyboardState,
     Modifiers, MouseButton, MouseEvent, MouseEventType, MouseState, Point,
 };
 
@@ -196,7 +196,7 @@
     Destroyed { view_id: ViewId },
     /// Input event from the view (Windows only).
     #[cfg(windows)]
-    Input { view_id: ViewId, event: InputEvent },
+    Input { view_id: ViewId, event: CoreInputEvent },
 }
 
 /// Callback for view events.
